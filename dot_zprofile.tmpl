# -*-mode:sh-*- vim:ft=zsh
# ~/.zprofile
# --------------------
# Loaded at *login shells*
#
# Focuses on system-level environment. This file is for essential 
# environment variables.
#
#=================================================================

export LANG=en_US.UTF-8
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"

# Homebrew installs to its preferred prefix;
# - /usr/local for macOS Intel
# - /opt/homebrew for Apple Silicon
# - /home/linuxbrew/.linuxbrew for Linux
#
source <(/opt/homebrew/bin/brew shellenv)

# Prepended deliberately: brew's python3 must beat the /usr/bin/python3 stub.
export PATH="$(brew --prefix python3)/bin:$PATH"
if [[ -d "$HOME/.volta" ]]; then
  export VOLTA_HOME="$HOME/.volta"
  export PATH="$PATH:$VOLTA_HOME/bin"
fi

export PATH="$PATH:$HOME/.local/share/git/git-commands"

export PATH="$PATH:$HOME/.rd/bin"

export PATH="$PATH:$HOME/Library/Application Support/JetBrains/Toolbox/scripts"

export PATH="$HOME/.local/bin:$PATH"

# TODO: Consider deferring this via zsh-defer?
export PATH="$PATH:$(go env GOPATH)/bin"

export PATH="$PATH:/Users/tkolleh/.cargo/bin"

# TODO: Consider deferring this via zsh-defer?
if [[ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]]; then
  # Enable shell command completion for gcloud.
  source "$HOME/google-cloud-sdk/path.zsh.inc"
  source "$HOME/google-cloud-sdk/completion.zsh.inc"
fi

# Pinned to a .pkg-installed JDK, not Coursier-managed. Coursier's arc/ cache
# can drop an extracted JDK ENTIRELY -- not merely revert its cacerts (observed
# 2026-09-25: the whole tree went, conf/security/policy/ included, so the JVM
# could not even init JCE: "Can't read cryptographic policy directory:
# unlimited") -- and silently re-extracting ~200MB mid-login blocked shell
# startup. /Library/Java/JavaVirtualMachines is Apple's system JVM registry
# (what /usr/libexec/java_home reads), not a cache dir, so nothing prunes it.
# Install/reinstall via: brew install --cask corretto@21
export JAVA_HOME="/Library/Java/JavaVirtualMachines/amazon-corretto-21.jdk/Contents/Home"

# Prepended deliberately: appending leaves /usr/bin ahead, so `java` resolves to
# the macOS stub. The stub happens to forward via JAVA_HOME, but that is macOS
# behaviour rather than a guarantee and it does not cover every tool in this dir
# (jshell, jcmd, jstack, native-image). set_java_home_to in ~/.zsh_functions and
# print_jvm_versions in ~/.local/bin assume this JDK's bin wins.
export PATH="$JAVA_HOME/bin:$PATH"

export PATH="$PATH:/Users/tkolleh/Library/Application Support/Coursier/bin"

{{ if (eq .chezmoi.hostname .chezmoi.config.data.work_hostname) }}

# Coursier-managed path, there's no safe re-resolve to fall back on; a broken
# system JVM means `brew reinstall --cask corretto@21`, not a silent retry mid-shell.
if [[ ! -x "$JAVA_HOME/bin/java" || ! -d "$JAVA_HOME/conf/security/policy/unlimited" ]]; then
  print -u2 -- "zprofile: WARNING JAVA_HOME broken ($JAVA_HOME); run: brew reinstall --cask corretto@21"
fi

# Corp CA trust for ALL JVMs, from one file outside any JDK.
#
# /etc/profile.d/zia-cert-env.sh (MDM) already wires curl/Node/Python/OpenSSL
# via SSL_CERT_FILE et al, but nothing there reaches the JVM -- it reads a
# keystore, not a PEM. The old fix imported the bundle into each JDK's own
# cacerts; that lives under Coursier's arc/ cache and dies with it. This store
# lives in ~/.config and survives.
#
# Rebuild on staleness (-nt), not mere absence, so an MDM cert rotation is
# picked up. Every branch is non-fatal: a login shell must still come up with
# working PATH/JAVA_HOME even if cert setup fails entirely.
export CORP_TRUSTSTORE="$HOME/.config/certs/corp-truststore.p12"
if [[ ! -f "$CORP_TRUSTSTORE" || /etc/ssl/certs/ca-bundle.pem -nt "$CORP_TRUSTSTORE" ]]; then
  # Sourced lazily, inside the rebuild branch, which runs only on first setup
  # or after an MDM cert rotation -- the common login path pays nothing.
  # Deliberately NOT ~/.host_functions.zsh: that file assumes the zsh plugin
  # manager is loaded (it calls __alias), which happens in ~/.zshrc, i.e. after
  # this file. corp-truststore.zsh is standalone and safe to source here.
  if ! typeset -f rebuild_corp_truststore >/dev/null && [[ -r "$HOME/.config/zsh/corp-truststore.zsh" ]]; then
    source "$HOME/.config/zsh/corp-truststore.zsh"
  fi
  if typeset -f rebuild_corp_truststore >/dev/null; then
    rebuild_corp_truststore || print -u2 -- "zprofile: corp truststore rebuild failed; using JDK cacerts"
  else
    print -u2 -- "zprofile: rebuild_corp_truststore undefined; JVMs use stock JDK cacerts"
  fi
fi
# JDK_JAVA_OPTIONS, not JAVA_TOOL_OPTIONS: same "Picked up ..." stderr banner,
# but JDK_JAVA_OPTIONS is read only by the `java` launcher, leaving keytool
# alone -- which matters, since keytool is what builds this store. The banner
# is stderr-only, so BSP/LSP JSON-RPC framing on stdout is unaffected.
if [[ -f "$CORP_TRUSTSTORE" ]]; then
  export JDK_JAVA_OPTIONS="-Djavax.net.ssl.trustStore=$CORP_TRUSTSTORE -Djavax.net.ssl.trustStorePassword=changeit -Djavax.net.ssl.trustStoreType=PKCS12"
fi

# Gap in the MDM profile.d script: Cargo reads neither SSL_CERT_FILE nor
# CURL_CA_BUNDLE, so it needs its own pointer at the same bundle.
export CARGO_HTTP_CAINFO="/etc/ssl/certs/ca-bundle.pem"

{{ end }}

# Bloop Build Server JVM Configuration
export BLOOP_JAVA_OPTS="\
  -XX:+UseZGC \
  -XX:ZUncommitDelay=30 \
  -Xmx8G \
  -Xss4M \
  -XX:CompressedClassSpaceSize=1024m \
  -XX:ReservedCodeCacheSize=1024m"

# Alerternative Ruby installation via Homebrew, to avoid conflicts with system Ruby
# MacOS has deprecated system Ruby, but some tools (e.g. fastlane) still require it.
#
export RUBY_PREFIX="$(brew --prefix ruby)"
export GEM_HOME="$HOME/.gem/ruby/4.0.0"
export GEM_BIN="$GEM_HOME/bin"
export PATH="$PATH:$RUBY_PREFIX/bin:$GEM_BIN"

# MacPorts: appended, not prepended, so it never shadows Homebrew/JDK/overrides above.
export PATH="$PATH:/opt/local/bin:/opt/local/sbin"
