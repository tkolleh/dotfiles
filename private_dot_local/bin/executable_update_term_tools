#!/usr/bin/env zsh
# -*-mode:zsh-*- vim:ft=zsh
#
# update_term_tools - Upgrade the terminal toolchain in one pass
#
# Usage:
#   update_term_tools
#
# Walks every package manager present on this machine (brew, atuin, zpm,
# coursier, pipx, npm/pnpm, uv, yazi, httpie, cargo, gem, agent skills)
# and upgrades it. Each step is guarded by a command check and trails
# `|| :` so one failing ecosystem does not abort the rest.
#
# Environment:
#   NVIM_VENV  if set to an existing dir, its pynvim is upgraded too
#
# Requires: roda (spinner); individual steps require their own tools

emulate -L zsh
setopt pipe_fail

if (( ${+commands[brew]} )); then
  roda --spinner "arc" --title "Upgrading outdated homebrew formulas..." -- brew upgrade --formula || :
fi
if (( ${+commands[atuin]} )); then
  roda --spinner "arc" --title "Syncing atuin history..." -- atuin sync || :
fi
if (( ${+commands[zpm]} )); then
  roda --spinner "arc" --title "Cleaning zpm..." -- zpm clean || :
  roda --spinner "arc" --title "Upgrading zpm..." -- zpm upgrade || :
fi
if (( ${+commands[cs]} )); then
  roda --spinner "arc" --title "Updating coursier..." -- cs update --quiet || :
fi
if (( ${+commands[pipx]} )); then
  roda --spinner "arc" --title "Upgrading all pipx packages..." -- pipx upgrade-all || :
fi
if (( ${+commands[node]} )); then
  roda --spinner "arc" --title "Updating global npm packages..." -- npm --global update || :
  roda --spinner "arc" --title "Updating pnpm ..." -- pnpm self-update || :
fi
if (( ${+commands[uv]} )); then
  roda --spinner "arc" --title "Updating uv tools..." -- uv tool upgrade --all || :
fi
if (( ${+commands[yazi]} )); then
  roda --spinner "arc" --title "Installing yazi plugins with locked versions from package.toml..." -- ya pkg install || :
  roda --spinner "arc" --title "Upgrading yazi plugins package.toml" -- ya pkg upgrade || :
fi
if (( ${+commands[httpie]} )); then
  roda --spinner "arc" --title "Upgrading httpie cli..." -- httpie cli check-updates || :
  roda --spinner "arc" --title "Upgrading httpie plugins..." -- httpie plugins upgrade httpie-jwt-auth httpie-image || :
fi
if (( ${+commands[cargo]} )); then
  roda --spinner "arc" --title "Upgrading cargo packages..." -- cargo install cargo-update || :
  roda --spinner "arc" --title "Upgrading cargo packages..." -- cargo install-update -a || :
fi
if [[ -n "$NVIM_VENV" ]] && [[ -d "$NVIM_VENV" ]]; then
  roda --spinner "arc" --title "Updating neovim python venv packages..." -- "$NVIM_VENV/bin/pip" install --upgrade pynvim || :
fi
if (( ${+commands[npx]} )); then
  roda --spinner "arc" --title "Update agent skills" -- npx skills update || :
fi
if (( ${+commands[skillfish]} )); then
  roda --spinner "arc" --title "Update agent skills" -- skillfish update --yes || :
fi
if (( ${+commands[skills]} )); then
  roda --spinner "arc" --title "Update agent skills" -- skills update --global --yes || :
fi
# Run `brew link --overwrite ruby --force` to use the latest ruby version
if (( ${+commands[gem]} )); then
  roda --spinner "arc" --title "Update ruby system gems" -- gem update || :
fi
