// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "proxy": "",
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "lsp": {
    "metals": {
          "settings": {
            "inlayHints": {
              "inferredTypes": {
                "enable": true
              },
              "implicitArguments": {
                "enable": false
              },
              "typeParameters": {
                "enable": false
              }
            }
          },
          "binary": {
            "arguments": [
              "-Dmetals.http=on"
            ]
          },
          "initialization_options": {
            "isHttpEnabled": true,
            "scalafixConfigPath": "project/.scalafix.conf"
          }
        }
  },
  // Zed's built-in agent. The enterprise Claude account is used via the
  // external `claude-acp` agent above (Agent Panel -> new thread), which wraps
  // the local Claude Code CLI and carries its own auth -- run `/login` in a
  // Claude Agent thread and pick the Claude Code option. Zed-side model/API-key
  // settings do NOT configure it, so no `default_model` is pinned here.
  "agent": {
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  // See: https://fontdrop.info/ for more information on font features
  "buffer_font_features": {
    "calt": true,
    "subs": false,
    "sups": false,
    "zero": true
  },
  "ui_font_size": 14,
  "buffer_font_size": 13,
  "base_keymap": "JetBrains",
  "theme": {
    "mode": "system",
    "light": "Dawnfox - blurred",
    "dark": "Ayu Dark"
  },
  "tab_size": 2,
  "vim_mode": true,
  // Mirror Neovim `vim.opt.wrap = true`. Toggle off per-buffer with the
  // command palette (`editor: toggle soft wrap`) like nvim's `yow`.
  "soft_wrap": "editor_width",
  "preferred_line_length": 100,
  // Mirror Neovim `vim.g.autoformat = false`: never reformat on save.
  // Format on demand with `space c f` (editor::Format), like nvim's <leader>cf.
  "format_on_save": "off",
  "show_completions_on_input": true,
  "vim": {
    // "always": use system clipboard
    // "never": don't use system clipboard
    // "on_yank": use system clipboard for yank operations
    "use_system_clipboard": "on_yank",
    // Lets `f` and `t` motions extend across multiple lines
    "use_smartcase_find": true
  },
  // LazyVim hybrid line numbers (number + relativenumber): Zed shows the
  // absolute number on the current line and relative numbers elsewhere.
  "relative_line_numbers": "enabled",
  "scrollbar": {
    "show": "auto"
  },
  // allow cursor to reach edges of screen
  "vertical_scroll_margin": 10,
  "inlay_hints": {
    "enabled": true
  },
  "git": {
    "inline_blame": {
      "enabled": true
    }
  },
  "terminal": {
    "cursor_shape": "block",
    "blinking": "terminal_controlled",
    "alternate_scroll": "off",
    "copy_on_select": true,
    "dock": "bottom",
    "detect_venv": {
      "on": {
        "directories": [
          ".env",
          "env",
          ".venv",
          "venv"
        ],
        "activate_script": "default"
      }
    },
    "env": {
      "TERM_CONTEXT": "zed_editor"
    },
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 12,
    "line_height": "comfortable",
    "option_as_meta": false,
    "button": false,
    "toolbar": {
      "breadcrumbs": true
    },
    "working_directory": "current_project_directory"
  },
  "context_servers": {}
}
