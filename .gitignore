# Secret-bearing files — never commit. Manage these via 1Password/GPG instead.
# (These exact names previously leaked credentials into git history.)
dot_bash_secrets
dot_bash_secrets.tmpl
dot_bash_options
dot_bash_profile
**/vfs.toml
.envrc
*.pem
*.key
private_*_key
*_rsa
id_*

# Allium loop ledger (local agent state)
.allium-loop/

# Managed scripts for ~/.local/bin. The global gitignore has a broad `[Bb]in/`
# rule (VS/JetBrains boilerplate) that would otherwise swallow this directory
# and silently leave these scripts untracked.
!private_dot_local/bin/
!private_dot_local/bin/**
